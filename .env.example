# img-sieve 异步任务 MySQL 连接配置（复制为 .env 后填写；keepalive.sh 启动时自动加载）
#
# 多机部署：MySQL 只装在其中一台（机器 A），其余机器把 HOST 指向机器 A 的内网 IP。
# 两台机器的 .env 内容只有 HOST 不同（都指向机器 A），其余相同。

IMG_SIEVE_MYSQL_HOST=127.0.0.1
IMG_SIEVE_MYSQL_PORT=3306
IMG_SIEVE_MYSQL_USER=imgsieve
IMG_SIEVE_MYSQL_PASSWORD=change-me
IMG_SIEVE_MYSQL_DB=imgsieve

# 可选：清理接口 /admin/purge 的访问令牌；不设置则内网裸用。
# IMG_SIEVE_ADMIN_TOKEN=
